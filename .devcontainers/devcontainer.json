{
  "name": "MuJoCo + ESP32 Dev",
  "dockerComposeFile": "../docker-compose.yml",
  "service": "dev",
  "workspaceFolder": "/workspace",
  "remoteUser": "dev",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-toolsai.jupyter",
        "njpwerner.autodocstring",
        "ms-azuretools.vscode-docker",
        "ms-vscode.cpptools",
        "platformio.platformio-ide"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "python.analysis.indexing": true,
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  },

  "postCreateCommand": "pip install -r requirements.txt || true",
  "containerEnv": {
    "MUJOCO_GL": "${localEnv:MUJOCO_GL-osmesa}",
    "MPLBACKEND": "Agg"
  },

  "mounts": [
    // keep pip cache between rebuilds (optional)
    "source=vscode-pip-cache,target=/home/dev/.cache/pip,type=volume"
  ],

  "features": {},
  "shutdownAction": "stopCompose",
  "ghcr.io/devcontainers/features/node:1": { "version": "20" }
}
